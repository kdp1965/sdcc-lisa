VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

# sdar (sdbinutils) may be unavailable: use the plain list-of-objects library format
LIB_TYPE     = LIST

# This Makefile.in builds three libraries: configure writes it as
# device/lib/lisa/Makefile (lisa.lib for the direct RAM of TT07), as
# device/lib/lisa-cache/Makefile (the same compiled with --tt07-cache,
# which the compiler links for --tt07-cache programs: get_model) and as
# device/lib/lisa-rev2/Makefile (compiled with --rev2 for the second chip:
# bf16_add on its hardware adder); the directory name tells which.  The
# sources are all in device/lib/lisa.
MODEL = $(notdir $(CURDIR))
LISASRC = $(srcdir)/../lisa
vpath %.s $(LISASRC)
vpath %.c $(LISASRC)

EXTRA_CFLAGS = -mlisa $(if $(filter lisa-cache,$(MODEL)),--tt07-cache) $(if $(filter lisa-rev2,$(MODEL)),--rev2) $(if $(filter lisa-rev2k,$(MODEL)),--pack-const)
# lisa-rev2k: constants packed (--pack-const, ttsky26d RESPIN 26) - the
# helpers that walk constant data take the k variants
K = $(if $(filter lisa-rev2k,$(MODEL)),k)

SAS = $(top_builddir)/bin/sdaslisa

override PORTDIR = ../build/$(MODEL)

# the .s sources first: memcpy.s / strlen.s stand in for ../memcpy.c /
# ../strlen.c, which the .c rules of incl.mk would otherwise pick.  They
# .include lisamodel.inc, which says whether this is the --tt07-cache
# library (TT07_CACHE: the cmp before each inx / dcx) or the --rev2 one
# (LISA_REV2: bf16_add is the hardware adder, T = 0: the byte on top of the
# stack is 0(sp), the stack pointer decrementing before a push; on TT07 it
# is 1(sp), T = 1 - the .s sources write their frame offsets as T+n(sp));
# the rule is below all:
%.rel: %.s lisamodel.inc
	@# TODO: sdas should place it\'s output in the current dir
	test "`cd $(dir $<) && pwd`" = "`pwd`" || cp $< .
	-$(AS) $(ASFLAGS) $(notdir $<)
	test "`cd $(dir $<) && pwd`" = "`pwd`" || rm $(notdir $<)

include $(srcdir)/../incl.mk

LISA_FLOAT = $(COMMON_FLOAT)

# the char, int and long divisions and remainders are divu.s and divul.s
# (the hardware divider)
LISA_INT = $(COMMON_INT) \
  _mulint.c \
  _mulschar.c

LISA_LONG = \
  _mullong.c

# the second chip's unsigned 64-bit division and remainder are divull.s
# (the chained divide step divc, ttsky26d RESPIN 27) with the generic loops
# renamed as its fallback for a wide divisor (divullb.c, modullb.c); TT07
# keeps the generic routines
REV2 = $(filter lisa-rev2 lisa-rev2k,$(MODEL))
LISA_LONGLONG = $(filter-out $(if $(REV2),_divulonglong.c _modulonglong.c),$(COMMON_LONGLONG) \
  _srulonglong.c \
  _srslonglong.c \
  _slulonglong.c \
  _slslonglong.c \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c)

LISA_SDCC = $(filter-out _memset.c,$(COMMON_SDCC)) \
  __itoa.c \
  __ltoa.c \
  _startup.c \
  _strncpy.c \
  _strcat.c \
  _strchr.c \
  strnlen.c \
  _memmove.c \
  _memcmp.c \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  vprintf.c \
  printf_large.c \
  puts.c \
  gets.c

LISASOURCES = $(addprefix ../,$(LISA_FLOAT) $(LISA_INT) $(LISA_LONG) $(LISA_LONGLONG) $(LISA_SDCC))
LISAOBJECTS = $(patsubst %.c,%.rel,$(LISA_FLOAT) $(LISA_INT) $(LISA_LONG) $(LISA_LONGLONG) $(LISA_SDCC))

# memcpy (with __memcpy), memset, strcpy, strlen and strcmp are assembly: a
# loop per space of the generic source, the pointers swapped through IX
OBJ = setjmp.rel atomic_flag_test_and_set.rel heap.rel divu.rel divul.rel gptrget$(K).rel bf16.rel bf16add.rel bf16c.rel \
  memcpy$(K).rel memset.rel strcpy$(K).rel strlen$(K).rel strcmp$(K).rel bcall.rel \
  $(if $(REV2),divull.rel divullb.rel modullb.rel)

LIB = lisa.lib
# --bf16-float: the float support routines on the bfloat16 unit, linked
# ahead of lisa.lib
LIB2 = bf16float.lib
OBJ2 = bf16fs.rel bf16fsc.rel
AS = $(SAS)
ASFLAGS = -plosgff

CFLAGS = -I$(srcdir)/../../include -I. --std-c23

all: $(PORTDIR)/$(LIB) $(PORTDIR)/$(LIB2)

# (below all: make's default goal is the first rule's target)
lisamodel.inc: Makefile
	echo "TT07_CACHE = $(if $(filter lisa-cache,$(MODEL)),1,0)" > $@
	echo "LISA_REV2 = $(if $(filter lisa-rev2 lisa-rev2k,$(MODEL)),1,0)" >> $@
	echo "T = $(if $(filter lisa-rev2 lisa-rev2k,$(MODEL)),0,1)" >> $@

$(PORTDIR)/$(LIB2): $(OBJ2) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ2)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ2)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ2)
    else
	rm -f $@
	for i in $(basename $(OBJ2)); do echo $$i >>$@; done
	cp $(OBJ2) $(PORTDIR)
	# --bf16-float links these as objects: the linker's listing update (-u) wants the .lst beside each
	cp $(OBJ2:.rel=.lst) $(PORTDIR)
    endif
  endif
endif

$(PORTDIR)/$(LIB): $(OBJ) $(LISAOBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(LISAOBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ) $(LISAOBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ) $(LISAOBJECTS)
    else
	rm -f $@
	for i in $(basename $(OBJ) $(LISAOBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(LISAOBJECTS) $(PORTDIR)
    endif
  endif
endif


clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib lisamodel.inc

distclean: clean
	rm -f Makefile

Makefile: $(LISASRC)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/$(MODEL)/Makefile
