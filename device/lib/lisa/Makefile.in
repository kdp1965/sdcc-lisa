VPATH  = @srcdir@
srcdir = @srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@

# sdar (sdbinutils) may be unavailable: use the plain list-of-objects library format
LIB_TYPE     = LIST

# This Makefile.in builds two libraries: configure writes it as
# device/lib/lisa/Makefile (lisa.lib for the direct RAM) and as
# device/lib/lisa-cache/Makefile (the same compiled with --tt07-cache,
# which the compiler links for --tt07-cache programs: get_model); the
# directory name tells which.  The sources are all in device/lib/lisa.
MODEL = $(notdir $(CURDIR))
LISASRC = $(srcdir)/../lisa
vpath %.s $(LISASRC)
vpath %.c $(LISASRC)

EXTRA_CFLAGS = -mlisa $(if $(filter lisa-cache,$(MODEL)),--tt07-cache)

SAS = $(top_builddir)/bin/sdaslisa

override PORTDIR = ../build/$(MODEL)

include $(srcdir)/../incl.mk

LISA_FLOAT = $(COMMON_FLOAT)

# the char, int and long divisions and remainders are divu.s and divul.s
# (the hardware divider)
LISA_INT = $(COMMON_INT) \
  _mulint.c \
  _mulschar.c

LISA_LONG = \
  _mullong.c

LISA_LONGLONG = $(COMMON_LONGLONG) \
  _srulonglong.c \
  _srslonglong.c \
  _slulonglong.c \
  _slslonglong.c \
  _mullonglong.c \
  _divslonglong.c \
  _divulonglong.c \
  _modslonglong.c \
  _modulonglong.c

LISA_SDCC = $(COMMON_SDCC) \
  __itoa.c \
  __ltoa.c \
  _startup.c \
  _strcmp.c \
  _strcpy.c \
  _strncpy.c \
  _strcat.c \
  _strchr.c \
  strlen.c \
  strnlen.c \
  _memmove.c \
  __memcpy.c \
  memcpy.c \
  _memset.c \
  _memcmp.c \
  div.c \
  ldiv.c \
  lldiv.c \
  sprintf.c \
  vprintf.c \
  printf_large.c \
  puts.c \
  gets.c

LISASOURCES = $(addprefix ../,$(LISA_FLOAT) $(LISA_INT) $(LISA_LONG) $(LISA_LONGLONG) $(LISA_SDCC))
LISAOBJECTS = $(patsubst %.c,%.rel,$(LISA_FLOAT) $(LISA_INT) $(LISA_LONG) $(LISA_LONGLONG) $(LISA_SDCC))

OBJ = setjmp.rel atomic_flag_test_and_set.rel heap.rel divu.rel divul.rel gptrget.rel bf16.rel bf16add.rel bf16c.rel

LIB = lisa.lib
# --bf16-float: the float support routines on the bfloat16 unit, linked
# ahead of lisa.lib
LIB2 = bf16float.lib
OBJ2 = bf16fs.rel bf16fsc.rel
AS = $(SAS)
ASFLAGS = -plosgff

CFLAGS = -I$(srcdir)/../../include -I. --std-c23

all: $(PORTDIR)/$(LIB) $(PORTDIR)/$(LIB2)

$(PORTDIR)/$(LIB2): $(OBJ2) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ2)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ2)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ2)
    else
	rm -f $@
	for i in $(basename $(OBJ2)); do echo $$i >>$@; done
	cp $(OBJ2) $(PORTDIR)
	# --bf16-float links these as objects: the linker's listing update (-u) wants the .lst beside each
	cp $(OBJ2:.rel=.lst) $(PORTDIR)
    endif
  endif
endif

$(PORTDIR)/$(LIB): $(OBJ) $(LISAOBJECTS) Makefile
ifeq ($(LIB_TYPE), SDCCLIB)
	rm -f $@; \
	$(top_builddir)/bin/sdcclib -a $@ $(OBJ) $(LISAOBJECTS)
else
  ifeq ($(LIB_TYPE), AR)
	$(SDAR) -rcSD $@ $(OBJ) $(LISAOBJECTS)
  else
    ifeq ($(LIB_TYPE), RANLIB)
	$(SDAR) -rcD $@ $(OBJ) $(LISAOBJECTS)
    else
	rm -f $@
	for i in $(basename $(OBJ) $(LISAOBJECTS)); do echo $$i >>$@; done
	cp $(OBJ) $(LISAOBJECTS) $(PORTDIR)
    endif
  endif
endif

%.rel: %.s
	@# TODO: sdas should place it\'s output in the current dir
	test "`cd $(dir $<) && pwd`" = "`pwd`" || cp $< .
	-$(AS) $(ASFLAGS) $(notdir $<)
	test "`cd $(dir $<) && pwd`" = "`pwd`" || rm $(notdir $<)

clean:
	rm -f *.rel *.sym *.lst *~ $(CLEANSPEC) *.dump* *.asm *.lib

distclean: clean
	rm -f Makefile

Makefile: $(LISASRC)/Makefile.in
	cd $(top_builddir); ./config.status device/lib/$(MODEL)/Makefile
